{
  "compilerOptions": {
    "incremental": true,
    "target": "es2021",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@unep/queue/*": [
        "./src/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "scripts/inspectOpenSearch.ts"],
  "exclude": ["node_modules"]
}
